rules_version = '2';

// ============================================================================
//  Habita - Reglas de Cloud Storage
//
//  Tres tipos de archivo, con reglas distintas:
//    reclamos/  - la foto que saca el residente al reportar una incidencia
//    avances/   - la foto de avance de obra (append-only, igual que el dato)
//    accesos/   - la captura del momento del ingreso, que escribe el backend
//
//  Todas las subidas tienen tope de tamano y validacion de content-type.
//  Sin eso, cualquiera con una cuenta puede usar el bucket como hosting gratis.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function auten() { return request.auth != null; }
    function claims() { return request.auth.token; }
    function rol() { return auten() ? claims().get('rol', '') : ''; }
    function miComplejo() { return auten() ? claims().get('complejoId', '') : ''; }
    function pertenece(cid) {
      return miComplejo() == cid
             || (rol() == 'superadmin' && cid in claims().get('complejos', []));
    }
    function esAdmin(cid) {
      return (rol() == 'admin_complejo' && miComplejo() == cid)
             || (rol() == 'superadmin' && cid in claims().get('complejos', []));
    }

    function esImagen() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }

    function pesoRazonable(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // --- fotos de reclamos ---------------------------------------------------
    match /complejos/{cid}/reclamos/{uid}/{archivo} {
      allow read: if pertenece(cid)
                  && (esAdmin(cid) || (rol() == 'residente' && request.auth.uid == uid));
      allow write: if pertenece(cid)
                   && (esAdmin(cid) || (rol() == 'residente' && request.auth.uid == uid))
                   && esImagen() && pesoRazonable(8);
    }

    // Compatibilidad de lectura administrativa para archivos creados antes de
    // separar las fotos por usuario. Los clientes nuevos no pueden escribir aca.
    match /complejos/{cid}/reclamos/{archivo} {
      allow read: if esAdmin(cid);
      allow write: if false;
    }

    // --- fotos de avance de obra ---------------------------------------------
    // Se pueden crear pero nunca reemplazar: el avance es append-only tambien
    // en el archivo, no solo en el documento.
    match /complejos/{cid}/obras/{obraId}/{archivo} {
      allow read: if esAdmin(cid)
                  || (miComplejo() == cid && rol() == 'responsable_obra'
                      && obraId in claims().get('obraIds', []));
      allow create: if (
                      esAdmin(cid)
                      || (miComplejo() == cid && rol() == 'responsable_obra'
                          && obraId in claims().get('obraIds', []))
                    ) && esImagen() && pesoRazonable(8);
      allow update, delete: if false;
    }

    // --- capturas del control de acceso --------------------------------------
    // Las escribe el backend con el Admin SDK. El cliente solo lee.
    match /complejos/{cid}/accesos/{archivo} {
      allow read: if esAdmin(cid)
                  || (miComplejo() == cid && rol() == 'guardia');
      allow write: if false;
    }

    // --- todo lo demas cerrado -----------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
