# Backend
NODE_ENV=development
PUERTO=8787
ORIGENES_PERMITIDOS=http://localhost:5000,http://127.0.0.1:5000

# Firebase. En local no se necesita una cuenta de servicio.
FIREBASE_PROJECT_ID=habita-demo
FIREBASE_STORAGE_BUCKET=habita-demo.appspot.com
USAR_EMULADORES=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GOOGLE_APPLICATION_CREDENTIALS=

# Reemplazar por un secreto largo y aleatorio antes de desplegar.
SECRETO_QR=habita-desarrollo-cambiar-en-produccion

# Mercado Pago. Sin token, Habita usa un checkout simulado local.
MP_ACCESS_TOKEN=
MP_URL_WEBHOOK=
MP_URL_RETORNO=http://localhost:5000/panel/pago-listo.html
MP_SECRETO_WEBHOOK=

# Clasificación de reclamos. Sin clave, usa un clasificador determinista local.
IA_PROVEEDOR=anthropic
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5
IA_URL_BASE=https://api.anthropic.com/v1/messages

# Opcionales
GOOGLE_MAPS_API_KEY=
BCRA_URL_BASE=https://api.bcra.gob.ar/estadisticas/v4.0
BCRA_SERIE_INFLACION=27
FCM_ACTIVO=true
LIMITE_PUBLICO_POR_MINUTO=30
LIMITE_AUTENTICADO_POR_MINUTO=240
